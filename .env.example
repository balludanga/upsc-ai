# --- Database (Postgres) ---
DATABASE_URL=postgresql://upsc_user:upsc_pass@localhost:5432/upsc_db

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=upsc_corpus

# --- Ollama (LLM + embeddings) ---
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:3b

# --- Handwritten answer uploads ---
# OCR engine for reading uploaded photos / scanned PDFs.
#   rapidocr      local PP-OCR on CPU, no extra model download (default)
#   ollama-vision Ollama vision model, needs a large local model
#   auto          rapidocr if installed, otherwise ollama-vision
OCR_ENGINE=rapidocr
OCR_MIN_CONFIDENCE=0.75

# Only used when OCR_ENGINE=ollama-vision.
VISION_MODEL=llava

UPLOAD_MAX_FILES=6
UPLOAD_MAX_BYTES=15728640
UPLOAD_MAX_PAGES=8
UPLOAD_RENDER_DPI=200

# --- Rate limiting ---
# Private installation: 0 means unlimited questions.
FREE_TIER_DAILY_LIMIT=0
